---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page Not Found | Sola Hair Salon"
  description="The page you're looking for could not be found."
  canonicalPath="/404/"
  noindex={true}
>
  <section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="font-serif text-4xl font-bold mb-4">Page Not Found</h1>
    <p class="text-ink/70 mb-8">The page you're looking for doesn't exist or may have moved.</p>
    <a href="/" class="px-6 py-3 rounded-full bg-rose-500 text-white font-medium hover:bg-rose-600 transition-colors">
      Back to Home
    </a>
  </section>
</Layout>
