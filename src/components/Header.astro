---
const nav = [
  { label: 'Sola Hair Salon', href: '/sola-hair-salon/' },
  { label: 'Hair Services', href: '/hair-services/' },
  { label: 'Hairstyles', href: '/hairstyles/' },
  { label: 'Hair Care', href: '/hair-care/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Blog', href: '/blog/' },
];
---
<header class="sticky top-0 z-40 bg-cream/85 backdrop-blur-md border-b border-sand/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-[68px]">
    <a href="/" class="flex items-center gap-2.5 group">
      <img src="/favicon.svg" alt="Sola Hair Salon logo" width="36" height="36" class="w-9 h-9 group-hover:scale-105 transition-transform drop-shadow" />
      <span class="font-serif text-xl font-semibold tracking-tight">Sola Hair Salon</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-[15px] font-medium text-ink/80">
      {nav.map((item) => (
        <a href={item.href} class="relative py-1 hover:text-rose-600 transition-colors after:absolute after:left-0 after:-bottom-0.5 after:h-[2px] after:w-0 after:bg-rose-500 hover:after:w-full after:transition-all">{item.label}</a>
      ))}
    </nav>

    <a href="/tools/salon-cost-calculator/" class="hidden lg:inline-flex items-center gap-1.5 rounded-full bg-ink text-cream text-sm font-medium px-5 py-2.5 hover:bg-rose-600 transition-colors">
      Estimate Cost
    </a>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
      class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-sand hover:border-rose-400 transition-colors ml-2"
    >
      <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1.5m0 15V21m9-9h-1.5M4.5 12H3m15.36-6.36l-1.06 1.06M6.7 17.3l-1.06 1.06m12.72 0l-1.06-1.06M6.7 6.7 5.64 5.64M16.5 12a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
      </svg>
      <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
      </svg>
    </button>

    <button
      id="menu-toggle"
      class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-sand"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="lg:hidden hidden border-t border-sand bg-cream">
    <ul class="px-4 py-3 space-y-1">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="block py-2 text-sm font-medium hover:text-rose-600">{item.label}</a>
        </li>
      ))}
      <li class="pt-2">
        <a href="/tools/salon-cost-calculator/" class="block text-center rounded-full bg-ink text-cream text-sm font-medium px-5 py-2.5">Estimate Cost</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!!isHidden));
  });

  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('icon-sun');
  const moonIcon = document.getElementById('icon-moon');

  function syncIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', !isDark);
    moonIcon?.classList.toggle('hidden', isDark);
  }
  syncIcons();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    syncIcons();
  });
</script>
