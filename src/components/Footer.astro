---
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-sand bg-ink text-cream/90">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid sm:grid-cols-2 lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2">
      <a href="/" class="flex items-center gap-2.5 mb-4">
        <img src="/favicon.svg" alt="Sola Hair Salon logo" width="36" height="36" class="w-9 h-9" />
        <span class="font-serif text-lg font-semibold text-white">Sola Hair Salon</span>
      </a>
      <p class="text-sm text-cream/60 leading-relaxed max-w-xs">
        Independent guides, tools and pricing insight for the Sola Salon Studios
        salon-suite model — built for people about to book, not for the brand
        itself.
      </p>
      <a href="mailto:salonsolahair@gmail.com" class="inline-block mt-4 text-sm text-cream/70 hover:text-white underline">
        salonsolahair@gmail.com
      </a>
    </div>
    <div>
      <h3 class="font-serif font-semibold mb-3 text-white">Explore</h3>
      <ul class="space-y-2 text-sm text-cream/70">
        <li><a href="/sola-hair-salon/" class="hover:text-white">Sola Hair Salon</a></li>
        <li><a href="/sola-salon-studio/" class="hover:text-white">Sola Salon Studio</a></li>
        <li><a href="/sola-salons/" class="hover:text-white">Sola Salons</a></li>
        <li><a href="/sola-salon-studios-near-me/" class="hover:text-white">Studios Near Me</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-serif font-semibold mb-3 text-white">Content</h3>
      <ul class="space-y-2 text-sm text-cream/70">
        <li><a href="/hair-services/" class="hover:text-white">Hair Services</a></li>
        <li><a href="/hairstyles/" class="hover:text-white">Hairstyles</a></li>
        <li><a href="/hair-care/" class="hover:text-white">Hair Care</a></li>
        <li><a href="/blog/" class="hover:text-white">Blog</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-serif font-semibold mb-3 text-white">Company</h3>
      <ul class="space-y-2 text-sm text-cream/70">
        <li><a href="/tools/" class="hover:text-white">Tools</a></li>
        <li><a href="/about/" class="hover:text-white">About</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
        <li><a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/terms/" class="hover:text-white">Terms</a></li>
        <li><a href="/disclaimer/" class="hover:text-white">Disclaimer</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <p class="text-xs leading-relaxed text-cream/50 max-w-3xl mb-3">
        <strong class="text-cream/70">Independent Website Notice:</strong> Sola Hair
        Salon is an independent informational resource. It is not an official Sola
        Salon Studios website and is not affiliated with, sponsored by, or endorsed
        by Sola Salon Studios unless explicitly stated. Trademarks belong to their
        respective owners.
      </p>
      <div class="flex flex-col sm:flex-row justify-between gap-2 text-xs text-cream/40">
        <p>&copy; {year} Sola Hair Salon. All rights reserved.</p>
        <p>solahairsalon.com</p>
      </div>
    </div>
  </div>
</footer>
